#config circle ci
version: 2.1 #versi circleci

#job / task
jobs:
  build-frontend: #job untuk build & push imag frontend
    docker:
      - image: cimg/base:stable #base image circleci
    steps:
      - checkout 
      - setup_remote_docker #mengaktifkan env docker pada circleci untuk build image
      - run:
          name: build dan push image frontend #nama pada dasboard
          command: | #kumpulan perintah untuk dirun
            echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GITHUB_USERNAME" --password-stdin
            FULL_IMAGE_NAME="ghcr.io/${GITHUB_USERNAME}/karsajob-ui:latest"
            docker build -t "$FULL_IMAGE_NAME" ./frontend
            docker push "$FULL_IMAGE_NAME"

  build-backend: #job untuk build dan push image baceknd
    docker:
      - image: cimg/base:stable #base image circleic
    steps:
      - checkout
      - setup_remote_docker #mengaktifkan env docker pada circleci untuk build image
      - run:
          name: build dan push image backend #nama pada dashboard
          command: | #kumpulan perintah untuk dirun
            echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GITHUB_USERNAME" --password-stdin
            FULL_IMAGE_NAME="ghcr.io/${GITHUB_USERNAME}/karsajobs:latest"
            docker build -t "$FULL_IMAGE_NAME" ./backend
            docker push "$FULL_IMAGE_NAME"


#workflow untuk mengatur urutan /kondisi jobs
workflows:
  version: 2
  build-and-push:
    jobs:
      - build-frontend: #jalankan job frontend
          filters: #branch filter
            branches:
              only: karsajobs-ui #jika commit push ke branch frontend
      - build-backend:
          filters: #branchfilter
            branches:
              only: karsajobs #nama branch backend pada repo
